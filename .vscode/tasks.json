{
    "version": "2.0.0",
    "tasks": [
        // ═══════════════════════════════════════════════════════════════════
        // SETUP
        // ═══════════════════════════════════════════════════════════════════
        {
            "label": "Setup: Full install",
            "type": "shell",
            "command": "bash setup.sh",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "new" },
            "problemMatcher": []
        },
        {
            "label": "Setup: Heimdall sudoers (run once)",
            "detail": "Installs NOPASSWD sudoers rules so Heimdall DAQ scripts run as root without a password prompt. Requires sudo password once.",
            "type": "shell",
            "command": "bash setup.sh --sudoers",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "presentation": { "reveal": "always", "panel": "new", "focus": true },
            "problemMatcher": []
        },

        // ═══════════════════════════════════════════════════════════════════
        // HEIMDALL DAQ
        // TCP ports: 5000 (IQ data) + 5001 (hw ctrl) — out_data_iface_type=eth
        // start_heimdall.sh auto-detects the firmware dir (~/krakensdr/…/Firmware_new
        // first, then external/heimdall_daq_fw/Firmware) and installs the sudoers
        // rule on first run so sudo bash daq_start_sm.sh never asks for a password.
        // ═══════════════════════════════════════════════════════════════════
        {
            "label": "Heimdall: Start — real hardware (Iridium 1626.270 MHz)",
            "detail": "Auto-detects firmware path, copies Iridium config, installs sudoers if needed, then runs daq_start_sm.sh as root.",
            "type": "shell",
            "command": "LARK_ROOT=${workspaceFolder} bash ${workspaceFolder}/krakenSDR/src/start_heimdall.sh",
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": {
                "pattern": { "regexp": "^(.*)$", "message": 1 },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting DAQ",
                    "endsPattern": "Have a coffee"
                }
            }
        },
        {
            "label": "Heimdall: Start — synthetic (no hardware)",
            "detail": "Auto-detects firmware path, installs sudoers if needed, then runs daq_synthetic_start.sh as root.",
            "type": "shell",
            "command": "LARK_ROOT=${workspaceFolder} bash ${workspaceFolder}/krakenSDR/src/start_heimdall.sh --synthetic",
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": {
                "pattern": { "regexp": "^(.*)$", "message": 1 },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting DAQ",
                    "endsPattern": "Have a coffee"
                }
            }
        },
        {
            "label": "Heimdall: Stop",
            "detail": "Kills all Heimdall sub-processes via daq_stop.sh (auto-detects firmware path).",
            "type": "shell",
            "command": "FW=$(bash -c 'for d in ~/krakensdr/heimdall_daq_fw/Firmware_new ~/krakensdr/heimdall_daq_fw/Firmware ${workspaceFolder}/external/heimdall_daq_fw/Firmware_new ${workspaceFolder}/external/heimdall_daq_fw/Firmware; do [ -f \"$d/daq_stop.sh\" ] && echo $d && break; done'); cd \"$FW\" && sudo bash \"$FW/daq_stop.sh\"",
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },

        // ═══════════════════════════════════════════════════════════════════
        // KRAKENSDR — Iridium reception
        // ═══════════════════════════════════════════════════════════════════
        {
            "label": "KrakenSDR: Iridium — burst detect (single channel)",
            "detail": "Iridium burst detector on a single antenna. Validates the HW chain before DoA.",
            "type": "shell",
            "command": "python3 pysdr_iridium_detect.py",
            "options": { "cwd": "${workspaceFolder}/krakenSDR/src" },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$python"
        },
        {
            "label": "KrakenSDR: Iridium — receiver → parser (pipe)",
            "detail": "Demodulates Iridium bursts and pipes RAW: lines to iridium-toolkit/iridium-parser.py for full protocol decode.",
            "type": "shell",
            "command": "python3 iridium_receiver.py --freq 1626270000 | python3 ~/krakensdr/iridium-toolkit/iridium-parser.py -p",
            "options": { "cwd": "${workspaceFolder}/krakenSDR/src" },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$python"
        },
        {
            "label": "KrakenSDR: Iridium — DoA L-band (multi-channel)",
            "detail": "DoA on Iridium bursts with MUSIC + Doppler tracking. Requires Heimdall active.",
            "type": "shell",
            "command": "python3 pysdr_doa_iridium.py",
            "options": { "cwd": "${workspaceFolder}/krakenSDR/src" },
            "group": "test",
            "dependsOn": "Heimdall: Start — real hardware (Iridium 1626.270 MHz)",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$python"
        },
        {
            "label": "KrakenSDR: Run test suite",
            "detail": "Unit tests for DoA algorithms (MUSIC, ESPRIT, Capon, ML). No hardware needed.",
            "type": "shell",
            "command": "python3 -m pytest test_doa.py -v --tb=short",
            "options": { "cwd": "${workspaceFolder}/krakenSDR/src" },
            "group": { "kind": "test", "isDefault": true },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$python"
        },

        // ═══════════════════════════════════════════════════════════════════
        // LIBRESDR — Iridium transmission
        // ═══════════════════════════════════════════════════════════════════
        {
            "label": "LibreSDR: Check AD9363 connection",
            "detail": "IIO diagnostics: shows channels, frequencies and current gain of the AD9363.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 check_device.py",
            "options": { "cwd": "${workspaceFolder}/libreSDR/src" },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$python"
        },
        {
            "label": "LibreSDR: TX realistic Iridium sim (1626.270 MHz)",
            "detail": "Generates and transmits π/4-DQPSK bursts with realistic LEO Doppler at 1626.270 MHz.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 iridium_realistic_sim.py --pass-dur 60",
            "options": { "cwd": "${workspaceFolder}/libreSDR/src" },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$python"
        },
        {
            "label": "LibreSDR: TX cyclic (continuous loop, 1626.270 MHz)",
            "detail": "Transmits a single IQ frame in a continuous cyclic DMA loop via AD9363.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 iridium_realistic_sim.py --pass-dur 60 --cyclic",
            "options": { "cwd": "${workspaceFolder}/libreSDR/src" },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": "$python"
        },

        // ═══════════════════════════════════════════════════════════════════
        // FULL SESSIONS (TX + RX simultaneous)
        // ═══════════════════════════════════════════════════════════════════
        {
            "label": "LARK: Full session — Heimdall + Iridium DoA + LibreSDR TX",
            "detail": "Starts Heimdall, then Iridium DoA receiver and LibreSDR TX in separate panels.",
            "dependsOn": [
                "Heimdall: Start — real hardware (Iridium 1626.270 MHz)",
                "KrakenSDR: Iridium — DoA L-band (multi-channel)",
                "LibreSDR: TX realistic Iridium sim (1626.270 MHz)"
            ],
            "dependsOrder": "sequence",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },

        // ═══════════════════════════════════════════════════════════════════
        // IRIDIUM TOOLKIT
        // ═══════════════════════════════════════════════════════════════════
        {
            "label": "iridium-toolkit: Parse .bits file",
            "detail": "Parses a RAW: lines file with iridium-parser.py from ~/krakensdr/iridium-toolkit/.",
            "type": "shell",
            "command": "python3 ~/krakensdr/iridium-toolkit/iridium-parser.py -p ${input:bitsFile}",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$python"
        }
    ],

    "inputs": [
        {
            "id": "bitsFile",
            "description": "Path to the .bits RAW: lines file",
            "default": "session.bits",
            "type": "promptString"
        }
    ]
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup: Full install",
            "type": "shell",
            "command": "bash setup.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Setup: Heimdall sudoers (run once)",
            "detail": "Installs NOPASSWD sudoers rules so Heimdall DAQ scripts run as root without a password prompt. Requires sudo password once.",
            "type": "shell",
            "command": "bash setup.sh --sudoers",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Heimdall: Start — real hardware (Iridium 1626.270 MHz)",
            "detail": "Auto-detects firmware path, copies Iridium config, installs sudoers if needed, then runs daq_start_sm.sh as root.",
            "type": "shell",
            "command": "LARK_ROOT=${workspaceFolder} bash ${workspaceFolder}/krakenSDR/src/scripts/start_heimdall.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting Heimdall DAQ",
                    "endsPattern": "Heimdall ready after"
                }
            }
        },
        {
            "label": "KrakenSDR: Iridium — burst detect (single channel)",
            "detail": "Iridium burst detector on a single antenna. Validates the HW chain before DoA.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/iridium/iridium_detector.py",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Iridium — receiver → parser (pipe)",
            "detail": "Demodulates Iridium bursts and pipes RAW: lines to iridium-toolkit/iridium-parser.py for full protocol decode.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/iridium/iridium_live.py --freq 1626270000 | python3 ${workspaceFolder}/external/iridium-toolkit/iridium-parser.py -p",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Iridium — DoA L-band (multi-channel)",
            "detail": "DoA on Iridium bursts with MUSIC + Doppler tracking. Requires Heimdall active.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/doa/doa_runner.py",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "dependsOn": "Heimdall: Start — real hardware (Iridium 1626.270 MHz)",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Run test suite",
            "detail": "Unit tests for DoA algorithms (MUSIC, ESPRIT, Capon, ML). No hardware needed.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 -m pytest tests/ -v --tb=short",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "LibreSDR: Check AD9363 connection",
            "detail": "IIO diagnostics: shows channels, frequencies and current gain of the AD9363.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 check_device.py",
            "options": {
                "cwd": "${workspaceFolder}/libreSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "iridium-toolkit: Parse .bits file",
            "detail": "Parses a RAW: lines file with iridium-parser.py from external/iridium-toolkit/.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 ${workspaceFolder}/external/iridium-toolkit/iridium-parser.py -p ${input:bitsFile}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Space DoA — Collect bursts",
            "detail": "Opens config dialog, connects to Heimdall, gates Iridium bursts from all 5 antennas, saves .npz/.json for offline 3D DoA. Requires Heimdall already running.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/space/space_collector.py",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Space DoA — Real-time (2D-MUSIC)",
            "detail": "Real-time 3D DoA with sky plot + 8-panel display. Opens config dialog; supports BURST (Iridium gated) or CW mode. Requires Heimdall already running.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/space/space_doa_realtime.py",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Space DoA — Playback (offline)",
            "detail": "Opens a .npz capture from space_collector or the realtime recorder and replays the full 2D DoA pipeline offline.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/space/space_doa_playback.py",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Iridium Pass Predict — compare DoA vs TLE",
            "detail": "Loads a .npz recording, runs DoA pipeline, downloads Iridium TLE catalogue, and compares observed vs predicted satellite positions.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/space/iridium_pass_predict.py",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Iridium — visible satellites NOW",
            "detail": "Shows currently visible Iridium NEXT satellites with Az/El/Doppler (auto-detects GPS position).",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/space/iridium_pass_predict.py --predict-now",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Iridium — predict passes (next 2h)",
            "detail": "Predicts all Iridium NEXT passes above 10° for the next 2 hours.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/space/iridium_pass_predict.py --predict-window 2",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: 868 MHz UCA — DoA 2D real-time (MUSIC)",
            "detail": "2D-MUSIC (azimuth + elevation) on the 5-element UCA at 868 MHz. Requires Heimdall active and LibreSDR beacon transmitting.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/doa_test_868/doa_test_868_realtime.py",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: 868 MHz UCA — DoA 2D real-time (Capon)",
            "detail": "2D-Capon (MVDR) on the 5-element UCA at 868 MHz. Less sensitive to source-count errors than MUSIC.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/doa_test_868/doa_test_868_realtime.py --algo capon",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: 868 MHz UCA — DoA 2D real-time + record (MUSIC)",
            "detail": "2D-MUSIC on the 5-element UCA at 868 MHz with continuous .npz recording to recordings/doa_868/. Auto-saves checkpoint every 300 frames. Requires Heimdall + LibreSDR pilot-tone beacon.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/doa_test_868/doa_test_868_realtime.py --out-dir ${workspaceFolder}/recordings/doa_868",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "LibreSDR: TX 868 MHz — pilot-tone beacon (+100 kHz, -15 dB)",
            "detail": "Transmits a CW pilot tone at LO+100 kHz (868.1+0.1 MHz) at -15 dB via AD9363. Matches KrakenSDR PILOT_TONE_OFFSET_HZ=100000. Stop with Ctrl+C.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 tx/cw.py --freq 868100000 --pilot-offset 100000 --gain -15",
            "options": {
                "cwd": "${workspaceFolder}/libreSDR/src"
            },
            "group": "test",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "LibreSDR",
                    "endsPattern": "TX active|Transmitting"
                }
            }
        },
        {
            "label": "KrakenSDR: 868 MHz UCA — DoA BURST (IRA preamble gate)",
            "detail": "Burst-gated 2D-MUSIC: detects IRA π/4-DQPSK bursts from LibreSDR tx_868_gui.py, extracts preamble tone at +3125 Hz (Rs/8), runs per-burst DoA. Requires Heimdall + LibreSDR in BURST mode.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/doa_test_868/doa_test_868_burst.py",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: 868 MHz UCA — DoA BURST demo (no hardware)",
            "detail": "Synthetic IRA burst at az=45° — tests burst DoA pipeline without hardware.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/doa_test_868/doa_test_868_burst.py --demo",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "LibreSDR: TX 868 MHz — GUI BURST (IRA π/4-DQPSK)",
            "detail": "Apre la GUI LibreSDR in modalità BURST IRA. Trasmette slot IRA π/4-DQPSK (preamble+dati) ogni 90 ms. Usare con 'DoA BURST'. Richiede hardware AD9363.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 tx/gui.py --mode ira",
            "options": {
                "cwd": "${workspaceFolder}/libreSDR/src"
            },
            "group": "test",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": {
                "pattern": { "regexp": "^(.*)$", "message": 1 },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "LibreSDR 868",
                    "endsPattern": "GUI closed|Done\\."
                }
            }
        },
        {
            "label": "LibreSDR: TX 868 MHz — GUI BURST demo (no hardware)",
            "detail": "GUI loopback sintetica in modalità IRA — nessun hardware richiesto. Utile per testare la catena TX+DoA senza AD9363.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 tx/gui.py --demo --mode ira",
            "options": {
                "cwd": "${workspaceFolder}/libreSDR/src"
            },
            "group": "test",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": {
                "pattern": { "regexp": "^(.*)$", "message": 1 },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "LibreSDR 868",
                    "endsPattern": "GUI closed|Done\\."
                }
            }
        },
        {
            "label": "LibreSDR: TX 868 MHz — CW cyclic (DoA beacon)",
            "detail": "Transmits a continuous pure carrier tone at 868.1 MHz via AD9363 DMA loop. Use as reference beacon for UCA DoA testing. Stop with Ctrl+C.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 tx/cw.py --freq 868100000",
            "options": {
                "cwd": "${workspaceFolder}/libreSDR/src"
            },
            "group": "test",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "LibreSDR TX",
                    "endsPattern": "TX active|Transmitting"
                }
            }
        },
        {
            "label": "LibreSDR: TX 868 MHz — Headless IRA burst (no GUI)",
            "detail": "Transmits authentic Iridium IRA π/4-DQPSK bursts at 868 MHz via AD9363. No display required — use over SSH. Loops forever until Ctrl+C. Pair with 'DoA BURST' task. Requires hardware AD9363.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 tx/ira.py --freq 868100000 --cyclic",
            "options": {
                "cwd": "${workspaceFolder}/libreSDR/src"
            },
            "group": "test",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "problemMatcher": {
                "pattern": { "regexp": "^(.*)$", "message": 1 },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Iridium IRA burst TX",
                    "endsPattern": "Done\\.|Stop requested"
                }
            }
        },
        {
            "label": "KrakenSDR: Calibration — auto (collect + train + validate)",
            "detail": "Full NN calibration pipeline on one or more recordings. Fetches satellite Az/El from CelesTrak, trains MLP, and produces report + plots. Accepts a single .npz file, multiple files (space-separated), or a directory.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/space/calibration_run.py auto ${input:calibInput}",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Calibration — collect dataset",
            "detail": "Extract phase-diff features + ground-truth labels from .npz recordings. Accepts single file, multiple files, or directory.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/space/calibration_run.py collect ${input:calibInput}",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Calibration — train model",
            "detail": "Train MLP on a collected calibration dataset.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/space/calibration_run.py train ${input:calibDataset}",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Calibration — phase offsets (direct MUSIC fix)",
            "detail": "Stima i phase offset per canale dal GT TLE. Salva phase_offsets_latest.json che viene caricato automaticamente all'avvio di space_doa_realtime.py.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/space/calibration_run.py phase-cal ${input:calibInput}",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },

        {
            "label": "KrakenSDR: Calibrate HW phase offsets — TX from North 0° (1626 MHz)",
            "detail": "Calibrazione hardware UCA: posiziona l'antenna 0 del KrakenSDR a Nord geografico, posiziona il LibreSDR TX a Nord (az=0°) a 1–3 m. Avvia prima 'LibreSDR: Indoor 1626 MHz — TX IRA burst'. Questo task raccoglie ~120 s di burst, calcola i phase offset per canale e li scrive automaticamente in config.py. Riavvia il DoA dopo.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 apps/doa_iridium/doa_iridium_burst.py --freq 1626.270 --max-sats 1 --calibrate 0.0 --no-plot --no-rec",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },

        {
            "label": "LibreSDR: Indoor 1626 MHz — TX IRA burst (lab DoA)",
            "detail": "Transmits IRA π/4-DQPSK bursts at 1626.270 MHz at −40 dB (higher power → better indoor SNR, dominates multipath at 1–2 m). Safety guard rejects gain > −20 dB. Ctrl+C to stop.",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python3 tx/indoor_1626.py --gain -45 --cyclic",
            "options": {
                "cwd": "${workspaceFolder}/libreSDR/src"
            },
            "group": "test",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "problemMatcher": {
                "pattern": { "regexp": "^(.*)$", "message": 1 },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "LibreSDR — INDOOR 1626",
                    "endsPattern": "Cyclic TX active|TX streaming complete|Done\\."
                }
            }
        },

        {
            "label": "KrakenSDR: Iridium DoA burst — 1626.270 MHz (headless)",
            "detail": "DoA su IRA burst a 1626.270 MHz senza GUI. Attende Heimdall, usa parametri da config.py. Output [DIAG] ogni 10s.",
            "type": "shell",
            "command": "LARK_ROOT=${workspaceFolder} ${workspaceFolder}/.venv/bin/python3 -u apps/doa_iridium/doa_iridium_burst.py --no-plot",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Iridium DoA burst — 1626.270 MHz (GUI)",
            "detail": "DoA con GUI interattiva (skyplot + MUSIC 2D + phase plot). Usa parametri da config.py.",
            "type": "shell",
            "command": "LARK_ROOT=${workspaceFolder} ${workspaceFolder}/.venv/bin/python3 -u apps/doa_iridium/doa_iridium_burst.py",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Iridium DoA — collect 5ch dataset (offline)",
            "detail": "Collects burst windows from all 5 antennas using the same burst detector/tone estimator as doa_iridium_burst.py, then annotates TLE-based ground truth.",
            "type": "shell",
            "command": "LARK_ROOT=${workspaceFolder} ${workspaceFolder}/.venv/bin/python3 -u apps/doa_iridium/doa_iridium_collect_dataset.py --max-time-s ${input:iridiumCollectSeconds} --max-bursts ${input:iridiumCollectBursts}",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "KrakenSDR: Iridium DoA — process dataset offline",
            "detail": "Runs offline DoA on a collected dataset and outputs per-burst estimates plus GT error summary when GT is available.",
            "type": "shell",
            "command": "LARK_ROOT=${workspaceFolder} ${workspaceFolder}/.venv/bin/python3 -u apps/doa_iridium/doa_iridium_process_offline.py --input ${input:iridiumDatasetFile} --algo ${input:iridiumOfflineAlgo}",
            "options": {
                "cwd": "${workspaceFolder}/krakenSDR/src"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "LARK: Indoor 1626 MHz — laboratorio completo (Heimdall + TX + DoA)",
            "detail": "Avvio in sequenza: 1) Heimdall DAQ 1626 MHz, 2) LibreSDR TX −60 dB, 3) DoA GUI. Usa questo per un test da zero.",
            "dependsOn": [
                "Heimdall: Start — real hardware (Iridium 1626.270 MHz)",
                "LibreSDR: Indoor 1626 MHz — TX IRA burst (lab DoA)",
                "KrakenSDR: Iridium DoA burst — 1626.270 MHz (GUI)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ],

    "inputs": [
        {
            "id": "bitsFile",
            "description": "Path to the .bits RAW: lines file",
            "default": "session.bits",
            "type": "promptString"
        },
        {
            "id": "calibInput",
